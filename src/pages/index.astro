---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../lib/urls';
const allProjects = await getCollection('projects');
const projects = allProjects.filter(p => p.data.featured).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);
const collageProjects = ['utat-sae', 'brush-and-sponge-holder', 'placeholder-one']
  .flatMap(id => allProjects.filter(project => project.id === id));
---
<BaseLayout>
  <header class="page-heading home-heading appear">
    <div class="home-heading-copy">
    <p class="eyebrow">Mechanical engineering · University of Toronto</p>
    <h1>Hi, I'm George<span class="accent">.</span></h1>
    <p class="lead">I'm Jiajie (George) Xue, a Mechanical Engineering student, Mech 2T9 + PEY. I enjoy turning ideas into practical designs through CAD, prototyping, and testing.</p>
    <a class="text-link" href={withBase('/about/')}>More about me →</a>
    </div>
    <nav class="project-collage" aria-label="Explore selected projects">
      {collageProjects.map(project => (
        <a class="collage-tile" href={withBase(`/projects/${project.id}/`)} aria-label={`View ${project.data.title}`}>
          <Image src={project.data.cover} alt={project.data.coverAlt} width={800}
            widths={project.data.cover.format === 'svg' ? undefined : [400, 800]}
            sizes="(min-width: 992px) 25vw, 60vw"
            format={project.data.cover.format === 'svg' ? 'svg' : 'webp'} />
          <span class="collage-label">{project.id === 'utat-sae' ? 'UT26 Maple' : project.data.title}<span aria-hidden="true"> ↗</span></span>
        </a>
      ))}
    </nav>
  </header>
  <section class="projects-section" aria-labelledby="featured-title">
    <div class="section-heading"><h2 id="featured-title">Featured projects</h2><a class="text-link" href={withBase('/projects/')}>View all projects →</a></div>
    <ul class="project-grid grid" data-columns="2">{projects.map(project => <ProjectCard project={project} />)}</ul>
    {projects.length === 0 && <p>Featured projects coming soon. Explore the full gallery for my latest work.</p>}
  </section>
</BaseLayout>
