---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';
import { siteConfig } from '../../config';
export async function getStaticPaths() {
  return (await getCollection('projects')).map(project => ({ params: { id: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const links = Object.entries(data.links ?? {}).filter(([, href]) => href);
const labels: Record<string, string> = { github: 'Source on GitHub', demo: 'View demo', report: 'Read report' };
---
<BaseLayout title={data.title} description={data.summary} image={data.cover.src}>
  <article>
    <header class="page-heading project-heading">
      <a class="back-link" href={withBase('/projects/')}>← All projects</a>
      <p class="eyebrow"><time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></p>
      <div class="project-heading-grid">
      <h1 class="appear">{data.title}</h1>
      <div class="project-heading-details">
      <p class="lead">{data.summary}</p>
      {siteConfig.projects.showTags && <ul class="tags" aria-label="Project tags">{data.tags.map(tag => <li>{tag}</li>)}</ul>}
      {links.length > 0 && <nav class="project-links" aria-label="Project resources">{links.map(([label, href]) => <a href={withBase(href!)}>{labels[label]} ↗</a>)}</nav>}
      </div>
      </div>
    </header>
    <Image class="project-cover" src={data.cover} alt={data.coverAlt} widths={data.cover.format === 'svg' ? undefined : [640, 960, 1440]} sizes="(max-width: 1120px) 100vw, 1120px" width={1440} loading="eager" format={data.cover.format === 'svg' ? 'svg' : 'webp'} />
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
